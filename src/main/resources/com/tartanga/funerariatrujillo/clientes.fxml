<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<StackPane alignment="CENTER_RIGHT" prefHeight="700" prefWidth="1000" style="-fx-background-color: #F5F0E8;" stylesheets="@styles.css"
           xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tartanga.funerariatrujillo.ClientesController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
    <children>
        <HBox spacing="0.0">
            <children>
                <StackPane HBox.hgrow="ALWAYS">
                    <children>
                        <VBox fx:id="vistaTabla" spacing="20.0" StackPane.alignment="TOP_LEFT">
                            <children>
                                <VBox spacing="5.0">
                                    <children>
                                        <Label text="Gestión de clientes" textFill="#2e1a0e" wrapText="true">
                                            <font>
                                                <Font name="Inter 18pt Bold" size="24.0" />
                                            </font>
                                        </Label>
                                        <Label text="Registra y consulta los datos de las personas responsables del servicio." textFill="#7a5230" wrapText="true">
                                            <font>
                                                <Font name="Inter 18pt Regular" size="14.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>

                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" prefHeight="40.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #D6CCBD; -fx-border-radius: 4; -fx-background-radius: 4;" HBox.hgrow="ALWAYS">
                                            <children>
                                                <SVGPath content="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" fill="#7a5230" scaleX="0.8" scaleY="0.8">
                                                    <HBox.margin>
                                                        <Insets left="10.0" right="5.0" />
                                                    </HBox.margin>
                                                </SVGPath>
                                                <TextField fx:id="txtBuscar" promptText="Buscar por nombre, teléfono o código" HBox.hgrow="ALWAYS">
                                                    <font>
                                                        <Font name="Inter 18pt Regular" size="14.0" />
                                                    </font>
                                                </TextField>
                                            </children>
                                        </HBox>
                                        <Button fx:id="btnNuevoCliente" minWidth="150.0" mnemonicParsing="false" prefHeight="40.0" text="Nuevo cliente" textFill="#2e1a0e">
                                            <font>
                                                <Font name="Inter 18pt Bold" size="14.0" />
                                            </font>
                                            <graphic>
                                                <SVGPath content="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" fill="#2e1a0e" scaleX="0.7" scaleY="0.7" />
                                            </graphic>
                                            <padding>
                                                <Insets left="15.0" right="15.0" />
                                            </padding>
                                        </Button>
                                    </children>
                                </HBox>

                                <VBox spacing="5.0" VBox.vgrow="ALWAYS">
                                    <children>
                                        <TableView fx:id="tablaClientes" prefHeight="350.0" style="-fx-border-color: #C8B99A; -fx-border-radius: 4; -fx-background-radius: 4; -fx-background-color: #FFFFFF;" VBox.vgrow="ALWAYS">
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                            <columns>
                                                <TableColumn fx:id="colID" maxWidth="800.0" minWidth="55.0" prefWidth="0.0" text="ID" />
                                                <TableColumn fx:id="colNombre" maxWidth="2000.0" minWidth="120.0" prefWidth="0.0" text="Nombre y apellidos" />
                                                <TableColumn fx:id="colDNI" maxWidth="1100.0" minWidth="85.0" prefWidth="0.0" text="DNI" />
                                                <TableColumn fx:id="colCorreo" maxWidth="2000.0" minWidth="120.0" prefWidth="0.0" text="Correo electrónico" />
                                                <TableColumn fx:id="colDireccion" maxWidth="2000.0" minWidth="120.0" prefWidth="0.0" text="Dirección" />
                                                <TableColumn fx:id="colTelefono" maxWidth="1000.0" minWidth="90.0" prefWidth="0.0" text="Teléfono" />
                                                <TableColumn fx:id="colFechaRegistro" maxWidth="1100.0" minWidth="95.0" prefWidth="0.0" text="Fecha de registro" />
                                            </columns>
                                        </TableView>
                                        <Label fx:id="lblEstadoTabla" text="0 clientes" textFill="#7a5230">
                                            <font>
                                                <Font name="Inter 18pt Regular" size="12.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <VBox fx:id="vistaDetalles" maxHeight="-Infinity" spacing="20.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #D6CCBD; -fx-border-radius: 8; -fx-background-radius: 8;" visible="false" StackPane.alignment="TOP_LEFT">
                            <padding>
                                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                            </padding>
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                    <children>
                                        <Button fx:id="btnVolver" mnemonicParsing="false" styleClass="button-back">
                                            <graphic>
                                                <SVGPath content="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z" fill="#7a5230" />
                                            </graphic>
                                        </Button>
                                        <VBox spacing="2.0">
                                            <Label text="Ficha del cliente" textFill="#2e1a0e" wrapText="true">
                                                <font>
                                                    <Font name="Inter 18pt Bold" size="22.0" />
                                                </font>
                                            </Label>
                                            <Label text="Datos de identificación, contacto y domicilio de facturación." textFill="#7a5230" wrapText="true">
                                                <font>
                                                    <Font name="Inter 18pt Regular" size="12.0" />
                                                </font>
                                            </Label>
                                        </VBox>
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Button fx:id="btnEliminar" minWidth="120.0" mnemonicParsing="false" prefHeight="35.0" styleClass="button-delete" text="Eliminar cliente" textFill="#C9302C">
                                            <font>
                                                <Font name="Inter 18pt Bold" size="13.0" />
                                            </font>
                                        </Button>
                                        <Button fx:id="btnEditar" minWidth="110.0" mnemonicParsing="false" prefHeight="35.0" styleClass="button-edit" text="Editar datos" textFill="#7a5230">
                                            <font>
                                                <Font name="Inter 18pt Bold" size="13.0" />
                                            </font>
                                        </Button>
                                        <Button fx:id="btnGuardarEdicion" managed="false" minWidth="130.0" mnemonicParsing="false" prefHeight="35.0" text="Guardar cambios" textFill="#2e1a0e" visible="false">
                                            <font>
                                                <Font name="Inter 18pt Bold" size="13.0" />
                                            </font>
                                        </Button>
                                    </children>
                                </HBox>

                                <VBox spacing="16.0">
                                    <children>
                                        <VBox spacing="12.0" style="-fx-background-color: #FAF7F2; -fx-border-color: #E6DEC8; -fx-border-radius: 6; -fx-background-radius: 6;">
                                            <padding>
                                                <Insets bottom="15.0" left="18.0" right="18.0" top="14.0" />
                                            </padding>
                                            <children>
                                                <Label text="DATOS PERSONALES Y CONTACTO" textFill="#7a5230">
                                                    <font>
                                                        <Font name="Inter 18pt Bold" size="11.0" />
                                                    </font>
                                                </Label>
                                                <HBox spacing="15.0">
                                                    <VBox prefWidth="0.0" spacing="5.0" HBox.hgrow="ALWAYS">
                                                        <Label text="Nombre" textFill="#7a5230">
                                                            <font>
                                                                <Font name="Inter 18pt Regular" size="12.0" />
                                                            </font>
                                                        </Label>
                                                        <TextField fx:id="txtDetalleNombre" editable="false" maxWidth="1.7976931348623157E308" prefHeight="38.0" prefWidth="0.0" />
                                                    </VBox>
                                                    <VBox prefWidth="0.0" spacing="5.0" HBox.hgrow="ALWAYS">
                                                        <Label text="Apellidos" textFill="#7a5230">
                                                            <font>
                                                                <Font name="Inter 18pt Regular" size="12.0" />
                                                            </font>
                                                        </Label>
                                                        <TextField fx:id="txtDetalleApellidos" editable="false" maxWidth="1.7976931348623157E308" prefHeight="38.0" prefWidth="0.0" />
                                                    </VBox>
                                                </HBox>
                                                <HBox spacing="15.0">
                                                    <VBox prefWidth="0.0" spacing="5.0" HBox.hgrow="ALWAYS">
                                                        <Label text="Documento de identidad" textFill="#7a5230">
                                                            <font>
                                                                <Font name="Inter 18pt Regular" size="12.0" />
                                                            </font>
                                                        </Label>
                                                        <TextField fx:id="txtDetalleDni" editable="false" maxWidth="1.7976931348623157E308" prefHeight="38.0" prefWidth="0.0" />
                                                    </VBox>
                                                    <VBox prefWidth="0.0" spacing="5.0" HBox.hgrow="ALWAYS">
                                                        <Label text="Teléfono" textFill="#7a5230">
                                                            <font>
                                                                <Font name="Inter 18pt Regular" size="12.0" />
                                                            </font>
                                                        </Label>
                                                        <TextField fx:id="txtDetalleTelefono" editable="false" maxWidth="1.7976931348623157E308" prefHeight="38.0" prefWidth="0.0" />
                                                    </VBox>
                                                    <VBox prefWidth="0.0" spacing="5.0" HBox.hgrow="ALWAYS">
                                                        <Label text="Correo electrónico" textFill="#7a5230">
                                                            <font>
                                                                <Font name="Inter 18pt Regular" size="12.0" />
                                                            </font>
                                                        </Label>
                                                        <TextField fx:id="txtDetalleCorreo" editable="false" maxWidth="1.7976931348623157E308" prefHeight="38.0" prefWidth="0.0" />
                                                    </VBox>
                                                </HBox>
                                            </children>
                                        </VBox>

                                        <VBox spacing="12.0" style="-fx-background-color: #FAF7F2; -fx-border-color: #E6DEC8; -fx-border-radius: 6; -fx-background-radius: 6;">
                                            <padding>
                                                <Insets bottom="15.0" left="18.0" right="18.0" top="14.0" />
                                            </padding>
                                            <children>
                                                <Label text="DIRECCIÓN POSTAL" textFill="#7a5230">
                                                    <font>
                                                        <Font name="Inter 18pt Bold" size="11.0" />
                                                    </font>
                                                </Label>
                                                <HBox spacing="15.0">
                                                    <VBox prefWidth="0.0" spacing="5.0" HBox.hgrow="ALWAYS">
                                                        <Label text="Calle" textFill="#7a5230">
                                                            <font>
                                                                <Font name="Inter 18pt Regular" size="12.0" />
                                                            </font>
                                                        </Label>
                                                        <TextField fx:id="txtDetalleCalle" editable="false" maxWidth="1.7976931348623157E308" prefHeight="38.0" prefWidth="0.0" />
                                                    </VBox>
                                                    <VBox prefWidth="0.0" spacing="5.0" HBox.hgrow="ALWAYS">
                                                        <Label text="Ciudad" textFill="#7a5230">
                                                            <font>
                                                                <Font name="Inter 18pt Regular" size="12.0" />
                                                            </font>
                                                        </Label>
                                                        <TextField fx:id="txtDetalleCiudad" editable="false" maxWidth="1.7976931348623157E308" prefHeight="38.0" prefWidth="0.0" />
                                                    </VBox>
                                                    <VBox maxWidth="160.0" minWidth="120.0" prefWidth="160.0" spacing="5.0">
                                                        <Label text="Código Postal" textFill="#7a5230">
                                                            <font>
                                                                <Font name="Inter 18pt Regular" size="12.0" />
                                                            </font>
                                                        </Label>
                                                        <TextField fx:id="txtDetalleCP" editable="false" maxWidth="1.7976931348623157E308" prefHeight="38.0" />
                                                    </VBox>
                                                </HBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </StackPane>

                <Region fx:id="spacerLateral" maxWidth="0.0" minWidth="0.0" prefWidth="0.0" />
            </children>
        </HBox>

        <VBox fx:id="panelFormularioNuevo" maxWidth="350.0" minWidth="350.0" prefWidth="350.0" spacing="0" style="-fx-background-color: #FFFFFF; -fx-border-color: #D6CCBD; -fx-border-radius: 8; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 15, 0, -3, 0);" translateX="400.0" visible="false">
            <children>
                <HBox alignment="CENTER_LEFT" style="-fx-padding: 25 25 10 25;">
                    <VBox spacing="5.0">
                        <children>
                            <Label text="Registrar cliente" textFill="#2e1a0e" wrapText="true">
                                <font>
                                    <Font name="Inter 18pt Bold" size="18.0" />
                                </font>
                            </Label>
                            <TextFlow>
                                <children>
                                    <Text fill="#7a5230" text="Los campos con " />
                                    <Text fill="#d9534f" text="*" />
                                    <Text fill="#7a5230" text=" son obligatorios." />
                                </children>
                            </TextFlow>
                        </children>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnCerrarFormulario" mnemonicParsing="false" styleClass="button-back">
                        <graphic>
                            <SVGPath content="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" fill="#7a5230" />
                        </graphic>
                    </Button>
                </HBox>

                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: #FFFFFF;" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox spacing="15.0" style="-fx-padding: 10 25 15 25;">
                            <children>
                                <HBox spacing="10.0">
                                    <VBox prefWidth="0.0" spacing="5.0" HBox.hgrow="ALWAYS">
                                        <Label text="Nombre *" textFill="#2e1a0e">
                                            <font>
                                                <Font name="System Bold" size="12.0" />
                                            </font>
                                        </Label>
                                        <TextField fx:id="txtNuevoNombre" maxWidth="1.7976931348623157E308" prefHeight="35.0" prefWidth="0.0" />
                                    </VBox>
                                    <VBox prefWidth="0.0" spacing="5.0" HBox.hgrow="ALWAYS">
                                        <Label text="Apellidos *" textFill="#2e1a0e">
                                            <font>
                                                <Font name="System Bold" size="12.0" />
                                            </font>
                                        </Label>
                                        <TextField fx:id="txtNuevoApellidos" maxWidth="1.7976931348623157E308" prefHeight="35.0" prefWidth="0.0" />
                                    </VBox>
                                </HBox>

                                <HBox spacing="10.0">
                                    <VBox prefWidth="0.0" spacing="5.0" HBox.hgrow="ALWAYS">
                                        <Label text="DNI *" textFill="#2e1a0e">
                                            <font>
                                                <Font name="System Bold" size="12.0" />
                                            </font>
                                        </Label>
                                        <TextField fx:id="txtNuevoDni" maxWidth="1.7976931348623157E308" prefHeight="35.0" prefWidth="0.0" />
                                    </VBox>
                                    <VBox prefWidth="0.0" spacing="5.0" HBox.hgrow="ALWAYS">
                                        <Label text="Teléfono *" textFill="#2e1a0e">
                                            <font>
                                                <Font name="System Bold" size="12.0" />
                                            </font>
                                        </Label>
                                        <TextField fx:id="txtNuevoTelefono" maxWidth="1.7976931348623157E308" prefHeight="35.0" prefWidth="0.0" />
                                    </VBox>
                                </HBox>

                                <VBox spacing="5.0">
                                    <Label text="Correo electrónico *" textFill="#2e1a0e">
                                        <font>
                                            <Font name="System Bold" size="12.0" />
                                        </font>
                                    </Label>
                                    <TextField fx:id="txtNuevoCorreo" maxWidth="1.7976931348623157E308" prefHeight="35.0" />
                                </VBox>

                                <VBox spacing="5.0">
                                    <Label text="Calle *" textFill="#2e1a0e">
                                        <font>
                                            <Font name="System Bold" size="12.0" />
                                        </font>
                                    </Label>
                                    <TextField fx:id="txtNuevoCalle" maxWidth="1.7976931348623157E308" prefHeight="35.0" />
                                </VBox>

                                <HBox spacing="10.0">
                                    <VBox prefWidth="0.0" spacing="5.0" HBox.hgrow="ALWAYS">
                                        <Label text="Ciudad *" textFill="#2e1a0e">
                                            <font>
                                                <Font name="System Bold" size="12.0" />
                                            </font>
                                        </Label>
                                        <TextField fx:id="txtNuevoCiudad" maxWidth="1.7976931348623157E308" prefHeight="35.0" prefWidth="0.0" />
                                    </VBox>
                                    <VBox maxWidth="105.0" minWidth="105.0" prefWidth="105.0" spacing="5.0">
                                        <Label text="Código Postal *" textFill="#2e1a0e">
                                            <font>
                                                <Font name="System Bold" size="12.0" />
                                            </font>
                                        </Label>
                                        <TextField fx:id="txtNuevoCP" maxWidth="1.7976931348623157E308" prefHeight="35.0" />
                                    </VBox>
                                </HBox>
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>

                <VBox style="-fx-padding: 10 25 25 25;">
                    <children>
                        <Button fx:id="btnGuardarNuevo" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="38.0" text="Guardar cliente" textFill="#2e1a0e">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Button>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</StackPane>