<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Font?>

<StackPane alignment="CENTER_RIGHT" prefHeight="700.0" prefWidth="1000.0" style="-fx-background-color: #F5F0E8;" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tartanga.funerariatrujillo.TrabajadorController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
    <children>
        <HBox spacing="0.0">
            <children>
                <StackPane HBox.hgrow="ALWAYS">
                    <children>
                        <VBox fx:id="vistaTabla" spacing="20.0" StackPane.alignment="TOP_LEFT">
                            <children>
                                <VBox spacing="5.0">
                                    <Label text="Gestión de trabajadores" textFill="#2e1a0e">
                                        <font>
                                            <Font name="Inter 18pt Bold" size="24.0" />
                                        </font>
                                    </Label>
                                    <Label text="Consulta el equipo y registra o edita sus datos personales y laborales." textFill="#7a5230">
                              <font>
                                 <Font size="14.0" />
                              </font></Label>
                                </VBox>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" prefHeight="40.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #D6CCBD; -fx-border-radius: 4; -fx-background-radius: 4;" HBox.hgrow="ALWAYS">
                                            <children>
                                                <SVGPath content="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" fill="#7a5230" scaleX="0.8" scaleY="0.8">
                                                    <HBox.margin>
                                                        <Insets left="10.0" right="5.0" />
                                                    </HBox.margin>
                                                </SVGPath>
                                                <TextField fx:id="txtBuscar" promptText="Buscar por nombre o cargo" HBox.hgrow="ALWAYS">
                                                    <font>
                                                        <Font name="Inter 18pt Regular" size="14.0" />
                                                    </font>
                                                </TextField>
                                            </children>
                                        </HBox>
                                        <Button fx:id="btnNuevoTrabajador" minWidth="150.0" mnemonicParsing="false" prefHeight="40.0" style="-fx-cursor: hand;" text="Nuevo trabajador" textFill="#2e1a0e">
                                            <font>
                                                <Font name="Inter 18pt Bold" size="14.0" />
                                            </font>
                                            <graphic>
                                                <SVGPath content="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" fill="#2e1a0e" scaleX="0.7" scaleY="0.7" />
                                            </graphic>
                                            <padding>
                                                <Insets left="15.0" right="15.0" />
                                            </padding>
                                        </Button>
                                    </children>
                                </HBox>
                                <TableView fx:id="tablaTrabajadores" prefHeight="370.0" style="-fx-border-color: #C8B99A; -fx-background-color: #FFFFFF;" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colNombre" prefWidth="300.0" text="Nombre y apellidos" />
                                        <TableColumn fx:id="colCargo" prefWidth="220.0" text="Cargo" />
                                    </columns>
                                </TableView>
                                <Label fx:id="lblEstadoTabla" text="0 trabajadores" textFill="#7a5230" />
                            </children>
                        </VBox>

                        <VBox fx:id="vistaDetalles" spacing="18.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #D6CCBD; -fx-border-radius: 8; -fx-background-radius: 8;" visible="false" StackPane.alignment="TOP_LEFT">
                            <padding>
                                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                            </padding>
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                    <children>
                                        <Button fx:id="btnVolver" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-cursor: hand;" styleClass="button-back">
                                            <graphic>
                                                <SVGPath content="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z" fill="#7a5230" />
                                            </graphic>
                                        </Button>
                                        <VBox>
                                            <Label text="Ficha del trabajador" textFill="#2e1a0e" wrapText="true">
                                                <font>
                                                    <Font name="Inter 18pt Bold" size="22.0" />
                                                </font>
                                            </Label>
                                        </VBox>
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Button fx:id="btnEliminar" minWidth="120.0" mnemonicParsing="false" prefHeight="35.0" style="-fx-background-color: #F9EBEA; -fx-border-color: #D9534F; -fx-border-radius: 4; -fx-cursor: hand;" text="Eliminar trabajador" textFill="#C9302C">
                                            <font>
                                                <Font name="Inter 18pt Bold" size="13.0" />
                                            </font>
                                        </Button>
                                        <Button fx:id="btnEditar" minWidth="110.0" mnemonicParsing="false" prefHeight="35.0" style="-fx-background-color: #F0E6C8; -fx-border-color: #E8A820; -fx-border-radius: 4; -fx-cursor: hand;" text="Editar datos" textFill="#7a5230">
                                            <font>
                                                <Font name="Inter 18pt Bold" size="13.0" />
                                            </font>
                                        </Button>
                                        <Button fx:id="btnGuardarEdicion" managed="false" minWidth="130.0" mnemonicParsing="false" prefHeight="35.0" style="-fx-background-color: #C68E17; -fx-background-radius: 4; -fx-cursor: hand;" text="Guardar cambios" textFill="#2e1a0e" visible="false">
                                            <font>
                                                <Font name="Inter 18pt Bold" size="13.0" />
                                            </font>
                                        </Button>
                                    </children>
                                </HBox>
                                <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                                    <children>
                                        <HBox spacing="12.0">
                                            <VBox HBox.hgrow="ALWAYS">
                                                <Label text="Nombre *" textFill="#7a5230" />
                                                <TextField fx:id="txtDetalleNombre" editable="false" />
                                            </VBox>
                                            <VBox HBox.hgrow="ALWAYS">
                                                <Label text="Apellidos *" textFill="#7a5230" />
                                                <TextField fx:id="txtDetalleApellidos" editable="false" />
                                            </VBox>
                                        </HBox>
                                        <HBox spacing="12.0">
                                            <VBox HBox.hgrow="ALWAYS">
                                                <Label text="DNI *" textFill="#7a5230" />
                                                <TextField fx:id="txtDetalleDni" editable="false" />
                                            </VBox>
                                            <VBox HBox.hgrow="ALWAYS">
                                                <Label text="Correo electrónico *" textFill="#7a5230" />
                                                <TextField fx:id="txtDetalleCorreo" editable="false" />
                                            </VBox>
                                            <VBox HBox.hgrow="ALWAYS">
                                                <Label text="Dirección *" textFill="#7a5230" />
                                                <TextField fx:id="txtDetalleCalle" editable="false" />
                                            </VBox>
                                        </HBox>
                                        <HBox spacing="12.0">
                                            <VBox HBox.hgrow="ALWAYS">
                                                <Label text="Ciudad *" textFill="#7a5230" />
                                                <TextField fx:id="txtDetalleCiudad" editable="false" />
                                            </VBox>
                                            <VBox HBox.hgrow="ALWAYS">
                                                <Label text="C.P. *" textFill="#7a5230" />
                                                <TextField fx:id="txtDetalleCP" editable="false" />
                                            </VBox>
                                            <VBox HBox.hgrow="ALWAYS">
                                                <Label text="Número SS *" textFill="#7a5230" />
                                                <TextField fx:id="txtDetalleSS" editable="false" />
                                            </VBox>
                                        </HBox>
                                        <HBox spacing="12.0">
                                            <VBox HBox.hgrow="ALWAYS">
                                                <Label text="IBAN *" textFill="#7a5230" />
                                                <TextField fx:id="txtDetalleIban" editable="false" />
                                            </VBox>
                                            <VBox HBox.hgrow="ALWAYS">
                                                <Label text="Salario *" textFill="#7a5230" />
                                                <TextField fx:id="txtDetalleSalario" editable="false" />
                                            </VBox>
                                            <VBox HBox.hgrow="ALWAYS">
                                                <Label text="Cargo *" textFill="#7a5230" />
                                                <ComboBox fx:id="cmbDetalleCargo" disable="true" maxWidth="1.7976931348623157E308" />
                                            </VBox>
                                        </HBox>
                                        <HBox spacing="12.0">
                                            <VBox prefWidth="220.0">
                                                <Label text="Tipo de jornada *" textFill="#7a5230" />
                                                <ComboBox fx:id="cmbDetalleJornada" disable="true" maxWidth="1.7976931348623157E308" />
                                            </VBox>
                                            <VBox prefWidth="220.0">
                                                <Label text="Rol *" textFill="#7a5230" />
                                                <ComboBox fx:id="cmbDetalleRol" disable="true" maxWidth="1.7976931348623157E308" />
                                            </VBox>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </StackPane>
                <Region fx:id="spacerLateral" maxWidth="0.0" minWidth="0.0" prefWidth="0.0" />
            </children>
        </HBox>

        <VBox fx:id="panelFormularioNuevo" maxWidth="370.0" minWidth="370.0" prefWidth="370.0" spacing="10.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #D6CCBD; -fx-border-radius: 8; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 15, 0, -3, 0);" translateX="400.0" visible="false">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <HBox>
                    <Label text="Registrar trabajador" textFill="#2e1a0e">
                        <font>
                            <Font name="Inter 18pt Bold" size="18.0" />
                        </font>
                    </Label>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnCerrarFormulario" style="-fx-background-color: transparent;">
                        <graphic>
                            <SVGPath content="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" fill="#7a5230" />
                        </graphic>
                    </Button>
                </HBox>
                <HBox spacing="8.0">
                    <TextField fx:id="txtNuevoNombre" promptText="Nombre *" HBox.hgrow="ALWAYS" />
                    <TextField fx:id="txtNuevoApellidos" promptText="Apellidos *" HBox.hgrow="ALWAYS" />
                </HBox>
                <HBox spacing="8.0">
                    <TextField fx:id="txtNuevoDni" promptText="DNI *" HBox.hgrow="ALWAYS" />
                    <TextField fx:id="txtNuevoCorreo" promptText="Correo electrónico *" HBox.hgrow="ALWAYS" />
                </HBox>
                <TextField fx:id="txtNuevoCalle" promptText="Dirección *" />
                <HBox spacing="8.0">
                    <TextField fx:id="txtNuevoCiudad" promptText="Ciudad *" HBox.hgrow="ALWAYS" />
                    <TextField fx:id="txtNuevoCP" promptText="C.P. *" HBox.hgrow="ALWAYS" />
                </HBox>
                <HBox spacing="8.0">
                    <TextField fx:id="txtNuevoSS" promptText="Número SS *" HBox.hgrow="ALWAYS" />
                    <TextField fx:id="txtNuevoIban" promptText="IBAN *" HBox.hgrow="ALWAYS" />
                </HBox>
                <HBox spacing="8.0">
                    <TextField fx:id="txtNuevoSalario" promptText="Salario *" HBox.hgrow="ALWAYS" />
                    <ComboBox fx:id="cmbNuevoCargo" promptText="Cargo *" HBox.hgrow="ALWAYS" />
                </HBox>
                <ComboBox fx:id="cmbNuevaJornada" promptText="Tipo de jornada *" />
                <TextField fx:id="txtNuevoUsuario" promptText="Usuario de acceso *" />
                <PasswordField fx:id="txtNuevaPassword" promptText="Contraseña (mínimo 8 caracteres) *" />
                <ComboBox fx:id="cmbNuevoRol" promptText="Rol *" />
                <Region VBox.vgrow="ALWAYS" />
                <Button fx:id="btnGuardarNuevo" maxWidth="1.7976931348623157E308" prefHeight="38.0" style="-fx-background-color: #C68E17; -fx-cursor: hand;" text="Guardar trabajador" />
            </children>
        </VBox>
    </children>
</StackPane>
