db.createCollection("cliente", {
	validator: {
		$jsonSchema: {
			bsonType: "object",
			required: ["nombre", "apellidos", "dni", "correo_electronico", "direccion", "telefono", "fecha_registro"],
			properties: {
				nombre: {
					bsonType: "string",
					description: "Debe ser una cadena de texto y es obligatorio"
				},
				apellidos: {
					bsonType: "string",
					description: "Debe ser una cadena de texto y es obligatorio"
				},
				dni: {
					bsonType: "string",
					pattern: "^[0-9]{8}[A-Z]$",
					description: "Debe ser un DNI válido (8 números y 1 letra) y es obligatorio"
				},
				correo_electronico: {
					bsonType: "string",
					pattern: "^.+@.+\\..+$",
					description: "Debe ser un correo válido y es obligatorio"
				},
				direccion: {
					bsonType: "object",
					required: ["calle", "ciudad", "codigo_postal"],
					properties: {
						calle: {
							bsonType: "string"
						},
						ciudad: {
							bsonType: "string"
						},
						codigo_postal: {
							bsonType: "string",
							pattern: "^[0-9]{5}$"
						}
					}
				},
				telefono: {
					bsonType: "string",
					description: "Debe ser una cadena de texto y es obligatorio"
				},
				fecha_registro: {
					bsonType: 'date',
					description: 'Debe ser una fecha y es obligatoria'
				}
			}
		}
	}
});

