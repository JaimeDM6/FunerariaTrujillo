				},
				apellidos: {
					bsonType: "string"
				},
				fecha_nacimiento: {
					bsonType: "date",
					description: "Debe ser una fecha y es obligatoria"
				},
				fecha_muerte: {
					bsonType: "date",
					description: "Debe ser una fecha y es obligatoria"
				},
				causa_de_muerte: {
					bsonType: "string"
