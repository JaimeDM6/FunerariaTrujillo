db.createCollection("asignacion", {
	validator: {
		$jsonSchema: {
			bsonType: "object",
			required: ["id_difunto", "id_trabajador", "estado", "fecha_asignacion"],
			properties: {
				id_difunto: {
					bsonType: "objectId",
					description: "Referencia al difunto al que pertenece el servicio (obligatorio)"
				},
				id_trabajador: {
					bsonType: "objectId",
					description: "Referencia al trabajador asignado al servicio (obligatorio)"
				},
				estado: {
					enum: ["Pendiente", "En curso", "Completado"],
					description: "Estado general del servicio (obligatorio)"
				},
				fecha_asignacion: {
					bsonType: "date",
					description: "Fecha y hora en la que se le asignó el trabajo al empleado (obligatorio)"
				},
				fecha_inicio_trabajo: {
					bsonType: "date",
					description: "Fecha y hora en la que el trabajador cambia el estado a 'En curso'"
				},
				fecha_finalizacion: {
					bsonType: "date",
					description: "Fecha y hora en la que se marca como 'Completado'"
				},
				indicaciones_familia: {
					bsonType: "string",
					description: "Texto libre con las indicaciones del servicio (ej. 'La familia solicita presentación sencilla')"
				},
				seguimiento: {
					bsonType: "object",
					properties: {
						paso_identificacion: {
							bsonType: "bool",
							description: "Equivale al checkbox: 'Comprobar identificación'"
						},
						paso_conservacion: {
							bsonType: "bool",
							description: "Equivale al checkbox: 'Realizar conservación temporal'"
						},
						paso_estetica: {
							bsonType: "bool",
							description: "Equivale al checkbox: 'Finalizar preparación estética'"
						},
						observaciones: {
							bsonType: "string",
							description: "Caja de texto de 'Observaciones de trabajo' escritas por el trabajador"
						},
						ultima_actualizacion: {
							bsonType: "date",
							description: "Fecha en la que el trabajador hizo el último clic en 'Guardar cambios'"
						}
					}
				}
			}
		}
	}
});

